<root main_tree_to_execute="NavigateThroughPoses">

  <BehaviorTree ID="NavigateThroughPoses">
    <PipelineSequence name="main_pipeline">
      <RateController hz="10.0">
        <RecoveryNode number_of_retries="1" name="recovery_node">
          <Sequence name="navigate_through_sequence">
            <TransformAvailable timeout="1.0" target_frame="map" source_frame="base_link"/>
            <ComputePathToPose ID="ComputePath_First" name="compute_path_to_pose" goal_blackboard_id="goal"/>
            <FollowPath ID="FollowPath_First" name="follow_path_through_poses" path_blackboard_id="path"/>
            <ComputePathToPose ID="ComputePath_Next" name="compute_next_pose" goal_blackboard_id="next_goal"/>
            <FollowPath ID="FollowPath_Next" name="follow_next_pose" path_blackboard_id="next_path"/>
          </Sequence>
        </RecoveryNode>
      </RateController>
    </PipelineSequence>
    <GoalReached/>
  </BehaviorTree>

</root>
